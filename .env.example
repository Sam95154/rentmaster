# Copy to .env.local. Only the public (anon) key belongs in the browser app.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Edge Function secrets are set with `supabase secrets set`, never in this file:
#   SITE_URL=https://your-app-domain
#   ALLOWED_ORIGIN=https://your-app-domain
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)
# Phase 3 will also need: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET
